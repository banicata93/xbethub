diff --git a/public/css/prediction-composer.css b/public/css/prediction-composer.css
new file mode 100644
index 0000000..b7c682c
--- /dev/null
+++ b/public/css/prediction-composer.css
@@ -0,0 +1,84 @@
+/* Scoped to Add New Prediction; the League Flag menu keeps its existing styles. */
+#addPredictionCard .card-header .card-title { color: #f8fafc; }
+#predictionForm > .row > div > .form-label { color: #e2e8f0; }
+#predictionForm > .row > div > .form-text { color: #cbd5e1; }
+
+.prediction-composer {
+    padding: 1rem;
+    border: 1px solid rgba(255, 255, 255, 0.18);
+    border-radius: 12px;
+    background: rgba(15, 23, 42, 0.62);
+    color: #f8fafc;
+}
+
+.prediction-composer [hidden] { display: none !important; }
+.prediction-composer .prediction-composer-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    flex-wrap: wrap;
+    gap: 0.65rem;
+    margin-bottom: 0.85rem;
+}
+.prediction-composer .prediction-title { margin: 0; font-size: 1rem; font-weight: 600; }
+.prediction-composer .prediction-mode { display: flex; gap: 0.3rem; }
+.prediction-composer button {
+    border: 1px solid rgba(255, 255, 255, 0.25);
+    border-radius: 8px;
+    background: rgba(255, 255, 255, 0.04);
+    color: #f8fafc;
+    font: inherit;
+    font-size: 0.88rem;
+    font-weight: 500;
+    min-height: 44px;
+    padding: 0.45rem 0.55rem;
+    cursor: pointer;
+    transition: background-color 0.15s ease, border-color 0.15s ease;
+}
+.prediction-composer .prediction-mode button { min-height: 36px; padding: 0.35rem 0.7rem; }
+.prediction-composer button:hover { background: rgba(52, 152, 219, 0.22); border-color: #93c5fd; }
+.prediction-composer button[aria-pressed="true"] { background: #2563eb; border-color: #93c5fd; color: #fff; }
+.prediction-composer button:focus-visible { outline: 2px solid #93c5fd; outline-offset: 3px; }
+.prediction-composer .prediction-categories {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr) minmax(0, 0.85fr);
+    gap: 0.85rem;
+}
+.prediction-composer fieldset { margin: 0; padding: 0; min-width: 0; border: 0; }
+.prediction-composer legend { float: none; margin: 0 0 0.4rem; font-size: 0.85rem; font-weight: 600; color: #cbd5e1; }
+.prediction-composer .prediction-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.35rem; }
+.prediction-composer .prediction-options-btts { grid-template-columns: 1fr; }
+.prediction-composer .prediction-hint { margin: 0.65rem 0 0; color: #cbd5e1; font-size: 0.78rem; }
+.prediction-composer .prediction-manual label { display: block; margin-bottom: 0.4rem; font-size: 0.85rem; color: #e2e8f0; }
+.prediction-composer .prediction-manual textarea { padding: 0.6rem 0.75rem; font-size: 0.95rem; resize: vertical; }
+.prediction-composer .prediction-preview {
+    display: flex;
+    align-items: baseline;
+    flex-wrap: wrap;
+    gap: 0.35rem 0.75rem;
+    margin-top: 0.85rem;
+    padding: 0.65rem 0.75rem;
+    border-radius: 8px;
+    background: rgba(52, 152, 219, 0.12);
+}
+.prediction-composer .prediction-preview-label { font-size: 0.78rem; color: #cbd5e1; }
+.prediction-composer output { font-size: 0.95rem; font-weight: 600; color: #fff; overflow-wrap: anywhere; }
+.prediction-composer .prediction-error { margin: 0.55rem 0 0; color: #fecaca; font-size: 0.85rem; }
+#predictionForm .prediction-form-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
+#predictionForm .prediction-form-actions .btn { min-height: 44px; padding: 0.65rem 1.25rem; font-size: 0.95rem; }
+
+@media (max-width: 767px) {
+    .prediction-composer { padding: 0.75rem; }
+    .prediction-composer .prediction-categories { grid-template-columns: 1fr; gap: 0.8rem; }
+    .prediction-composer .prediction-options-btts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+    .prediction-composer .prediction-preview { flex-direction: column; gap: 0.2rem; }
+}
+@media (max-width: 400px) {
+    .prediction-composer .prediction-options-goals { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+@media (max-width: 575px) {
+    #predictionForm #matchDate { flex: 1 0 100%; width: 100%; margin-bottom: 0.5rem; border-radius: 10px; }
+    #predictionForm #matchDate ~ button { flex: 1 1 0; }
+    #predictionForm .prediction-form-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
+    #predictionForm .prediction-form-actions .btn { padding: 0.6rem 0.4rem; font-size: 0.8rem; }
+}
diff --git a/public/js/prediction-composer.js b/public/js/prediction-composer.js
new file mode 100644
index 0000000..df7c69c
--- /dev/null
+++ b/public/js/prediction-composer.js
@@ -0,0 +1,122 @@
+(function(root, factory) {
+    const composer = factory();
+    if (typeof module === 'object' && module.exports) module.exports = composer;
+    else root.PredictionComposer = composer;
+})(typeof globalThis !== 'undefined' ? globalThis : this, function() {
+    'use strict';
+
+    const options = Object.freeze({
+        outcome: Object.freeze(['1', 'X', '2', '1X', 'X2', '12']),
+        goals: Object.freeze(['Over 1.5', 'Over 2.5', 'Over 3.5', 'Under 1.5', 'Under 2.5', 'Under 3.5']),
+        btts: Object.freeze(['BTTS Yes', 'BTTS No'])
+    });
+    const categories = Object.keys(options);
+    const controllers = new WeakMap();
+
+    function toggleSelection(selection, category, value) {
+        if (!Object.hasOwn(options, category) || !options[category].includes(value)) return selection;
+        return { ...selection, [category]: selection[category] === value ? null : value };
+    }
+
+    function compose(selection) {
+        return categories.map(category => selection[category])
+            .filter((value, index) => options[categories[index]].includes(value))
+            .join(' + ');
+    }
+
+    function initialize(form) {
+        if (!form) return null;
+        if (controllers.has(form)) return controllers.get(form);
+        const root = form.querySelector('[data-prediction-composer]');
+        if (!root) return null;
+
+        const field = form.querySelector('#prediction');
+        const manual = root.querySelector('#manualPrediction');
+        const manualPanel = root.querySelector('[data-prediction-manual]');
+        const choices = root.querySelector('[data-prediction-choices]');
+        const preview = root.querySelector('#predictionPreview');
+        const error = root.querySelector('#predictionError');
+        const optionButtons = Array.from(root.querySelectorAll('[data-prediction-category]'));
+        const modeButtons = Array.from(root.querySelectorAll('[data-prediction-mode]'));
+        let selection = {};
+        let mode = 'combined';
+
+        function getValue() {
+            return mode === 'manual' ? manual.value.trim() : compose(selection);
+        }
+
+        function update() {
+            const value = getValue();
+            field.value = value;
+            preview.textContent = value || (mode === 'manual' ? 'Въведи нестандартна прогноза' : 'Избери поне една опция');
+            root.dataset.mode = mode;
+            choices.hidden = mode !== 'combined';
+            manualPanel.hidden = mode !== 'manual';
+            manual.disabled = mode !== 'manual';
+            manual.required = mode === 'manual';
+            error.hidden = true;
+            error.textContent = '';
+            manual.removeAttribute('aria-invalid');
+            for (const button of optionButtons) {
+                button.setAttribute('aria-pressed', String(selection[button.dataset.predictionCategory] === button.dataset.predictionValue));
+            }
+            for (const button of modeButtons) {
+                button.setAttribute('aria-pressed', String(button.dataset.predictionMode === mode));
+            }
+        }
+
+        function validate() {
+            const value = getValue();
+            const message = !value ? 'Избери поне една опция или въведи прогноза ръчно.'
+                : value.length > 200 ? 'Прогнозата може да съдържа до 200 знака.' : '';
+            if (!message) return true;
+            error.textContent = message;
+            error.hidden = false;
+            if (mode === 'manual') {
+                manual.setAttribute('aria-invalid', 'true');
+                manual.focus();
+            } else {
+                optionButtons[0].focus();
+            }
+            return false;
+        }
+
+        function reset() {
+            selection = {};
+            mode = 'combined';
+            manual.value = '';
+            update();
+        }
+
+        root.addEventListener('click', event => {
+            const button = event.target.closest('button');
+            if (!button || !root.contains(button)) return;
+            if (button.dataset.predictionMode) {
+                mode = button.dataset.predictionMode === 'manual' ? 'manual' : 'combined';
+                update();
+                if (mode === 'manual') manual.focus();
+            } else if (mode === 'combined' && button.dataset.predictionCategory) {
+                selection = toggleSelection(selection, button.dataset.predictionCategory, button.dataset.predictionValue);
+                update();
+            }
+        });
+        manual.addEventListener('input', update);
+        form.addEventListener('reset', reset);
+
+        const controller = {
+            getValue,
+            validate,
+            reset,
+            setManualValue(value) {
+                manual.value = String(value ?? '');
+                mode = 'manual';
+                update();
+            }
+        };
+        controllers.set(form, controller);
+        update();
+        return controller;
+    }
+
+    return { options, toggleSelection, compose, initialize, get: form => controllers.get(form) };
+});
diff --git a/test/prediction-composer.test.js b/test/prediction-composer.test.js
